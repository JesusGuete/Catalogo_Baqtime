---
// Portado tal cual desde .portada-carousel en index.html + collections-carousel.js.
// El scroll (arrastre táctil/mouse) sigue siendo 100% nativo vía CSS scroll-snap —
// el script de abajo solo mueve el scroll cuando se hace clic en las flechas,
// igual que hacía collections-carousel.js. Por eso esto NO es una isla React
// (ver tabla "Qué es isla React y qué no" en docs/plan-mejoramiento.md).
//
// TEMPORAL: mismas URLs de imagen de Firebase Storage que Hero.astro, por la misma razón
// (no hay todavía pipeline de imágenes de Astro/Supabase). Se reemplazan en la Fase 2.
const STORAGE = "https://firebasestorage.googleapis.com/v0/b/baqtimecatalogo.firebasestorage.app/o/";
const collections = [
  { id: "Tote", title: "Tote Personalizado", category: "tote",
    desc: "Bolso tote bordado con tus iniciales. Perfecto para el día a día.",
    img: STORAGE + "site-images%2Ftote_personalizado.webp?alt=media&token=094f1a01-786f-496e-baa7-79ef8f398b46",
    w: 785, h: 785 },
  { id: "Luxury", title: "Tote Bag Luxury", category: "tote-luxury",
    desc: "La versión premium del tote, en acabados más finos. Personalizable con hasta 2 iniciales.",
    img: STORAGE + "site-images%2FTote%20luxury.webp.jpeg?alt=media&token=1dbf557b-7ef4-4588-ad5b-bd06b464815d",
    w: 785, h: 785 },
  { id: "Lumiere", title: "Bag Lumiere", category: "lumiere",
    desc: "Bolso tipo hobo, elegante y listo para usar, sin personalización. Un básico versátil para cualquier look.",
    img: STORAGE + "site-images%2Flumiere_negro_life1.webp?alt=media&token=f71fb1c8-e8d1-45bf-8f99-401e5efd29dc",
    w: 900, h: 1200 },
  { id: "Cosmetiquera", title: "Cosmetiquera", category: "cosmetiquera",
    desc: "Cosmetiquera personalizable con hasta 2 iniciales, del tamaño justo para tus básicos de maquillaje.",
    img: STORAGE + "site-images%2FCosmetiqueras.webp?alt=media&token=6cbafde7-d2c2-4241-8d3f-c0f082d73a02",
    w: 900, h: 900 },
  { id: "Neceser", title: "Neceser", category: "neceser",
    desc: "Neceser de cuero vegano personalizable con máximo 2 letras. Ideal para viajes y el día a día.",
    img: STORAGE + "site-images%2Fneceser_portada1.webp?alt=media&token=e34fef95-b931-456e-b667-a9ec3db8ec15",
    w: 900, h: 900 },
  { id: "Makeup", title: "Makeup Bag", category: "makeup-bag",
    desc: "Makeup bag personalizable con hasta 3 iniciales, pensada para organizar tus productos de belleza con estilo.",
    img: STORAGE + "site-images%2FMakeup%20Bag%20portada1.webp?alt=media&token=3c37e9f0-8049-4d2f-b38c-2bf6624960c0",
    w: 900, h: 900 },
];
---
<h2 class="portada-heading">Nuestras colecciones</h2>
<div class="portada-carousel">
  <button type="button" class="portada-arrow portada-arrow-left" id="portadaPrevBtn" aria-label="Ver colecciones anteriores">‹</button>
  <div class="portada-viewport">
    <div class="portada" id="portadaTrack">
      {collections.map((c) => (
        <div class="portada-card">
          <div class="portada-img"><img src={c.img} alt={c.title} width={c.w} height={c.h} /></div>
          <div class="portada-body">
            <h3>{c.title}</h3>
            <p>{c.desc}</p>
            <a href="#catalogo" class="btn btn-ghost" data-category={c.category}>Ver colección</a>
          </div>
        </div>
      ))}
    </div>
  </div>
  <button type="button" class="portada-arrow portada-arrow-right" id="portadaNextBtn" aria-label="Ver más colecciones">›</button>
</div>

<script>
  // Flechas: scroll nativo, un "paso" = el ancho de una tarjeta + separación.
  // Portado tal cual desde collections-carousel.js.
  const viewport = document.querySelector<HTMLElement>(".portada-viewport")!;
  const track = document.getElementById("portadaTrack")!;
  const prevBtn = document.getElementById("portadaPrevBtn") as HTMLButtonElement;
  const nextBtn = document.getElementById("portadaNextBtn") as HTMLButtonElement;
  const cards = Array.from(track.children) as HTMLElement[];

  function cardStep() {
    const cardWidth = cards[0].getBoundingClientRect().width;
    const gap = parseFloat(getComputedStyle(track).gap) || 0;
    return cardWidth + gap;
  }

  function updateArrows() {
    const maxScroll = track.scrollWidth - viewport.clientWidth;
    prevBtn.disabled = viewport.scrollLeft <= 1;
    nextBtn.disabled = viewport.scrollLeft >= maxScroll - 1;
  }

  prevBtn.addEventListener("click", () => {
    viewport.scrollBy({ left: -cardStep(), behavior: "smooth" });
  });
  nextBtn.addEventListener("click", () => {
    viewport.scrollBy({ left: cardStep(), behavior: "smooth" });
  });
  viewport.addEventListener("scroll", updateArrows);
  window.addEventListener("resize", updateArrows);
  updateArrows();

  // Enlaces "Ver colección": la isla React del catálogo (CatalogExplorer) escucha este
  // evento para cambiar de categoría. Es la misma idea que el "callback injection" que
  // usaba catalog-filters.js/main.js, adaptada a que ahora son dos componentes
  // separados (Astro estático + isla React) que no comparten estado directamente.
  document.querySelectorAll<HTMLAnchorElement>("a[data-category]").forEach((link) => {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      const category = link.dataset.category || null;
      window.dispatchEvent(new CustomEvent("baqtime:set-category", { detail: { category } }));
      document.getElementById("catalogo")?.scrollIntoView();
    });
  });
</script>
