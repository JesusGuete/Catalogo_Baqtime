---
// Pantalla de carga de la portada.
//
// TRES DECISIONES QUE LA HACEN SEGURA, y ninguna es opcional:
//
// 1. NACE OCULTA Y LA MUESTRA EL SCRIPT. Si el visitante tiene JavaScript apagado o el
//    script falla al cargar, la pantalla no aparece nunca y ve el sitio normal. Al revés
//    —nacer visible y ocultarse con JS— cualquier fallo dejaría la tienda tapada para
//    siempre, que es la peor falla posible en una página de ventas.
//
// 2. EL CSS LA RETIRA SOLA A LOS 3,5 SEGUNDOS, pase lo que pase. Es la red por si el
//    script que la oculta se rompe: la animación corre por su cuenta, sin depender de
//    nada. Siempre tiene que quedar POR ENCIMA del tope duro del script (2,5 s), o se
//    dispararía antes y taparía el cierre normal.
//
// 3. NO ESPERA A QUE CARGUE TODO. Espera la imagen del hero —lo único que se ve al
//    entrar— con un tope de 2,5 s. Esperar las 32 fotos del catálogo haría al sitio más
//    lento de lo que ya se siente, que es justo lo contrario de lo que se busca.
//
// El contenido real sigue en el HTML detrás de la pantalla: Google lo lee igual, porque
// esto tapa visualmente pero no quita nada del documento.
---

<div id="pantalla-carga" class="carga" hidden aria-hidden="true">
  <img src="/assets/img/logo.png" alt="" width="998" height="297" class="carga-logo" />
</div>

<script is:inline>
  (function () {
    var CLAVE = "baqtime_carga_vista";
    var pantalla = document.getElementById("pantalla-carga");
    if (!pantalla) return;

    // Una sola vez por visita: ver la misma animación al volver del catálogo cansa y hace
    // sentir el sitio más lento de lo que es.
    try {
      if (sessionStorage.getItem(CLAVE)) return;
      sessionStorage.setItem(CLAVE, "1");
    } catch (e) {
      // Navegación privada puede bloquear sessionStorage. Se muestra igual: es preferible
      // mostrarla de más que romper el arranque por no poder escribir una marca.
    }

    pantalla.hidden = false;
    document.documentElement.classList.add("esta-cargando");

    var cerrada = false;
    function cerrar() {
      if (cerrada) return;
      cerrada = true;
      pantalla.classList.add("is-lista");
      document.documentElement.classList.remove("esta-cargando");
      // Se saca del DOM al TERMINAR el desvanecido (0,6 s) para que no atrape ningún
      // clic. Si este número quedara por debajo de esa duración, la pantalla
      // desaparecería de golpe a mitad del fundido.
      setTimeout(function () {
        pantalla.remove();
      }, 700);
    }

    // El mínimo tiene que alcanzar para que el logo TERMINE de aparecer (0,7 s de
    // fundido). Con menos, en una carga rápida se cortaría a mitad de la entrada y se
    // vería justo lo que se quiere evitar: un salto.
    var desde = Date.now();
    function cerrarConMinimo() {
      var falta = 1000 - (Date.now() - desde);
      setTimeout(cerrar, falta > 0 ? falta : 0);
    }

    var hero = document.getElementById("heroImg");
    if (hero && !hero.complete) {
      hero.addEventListener("load", cerrarConMinimo);
      hero.addEventListener("error", cerrarConMinimo); // una foto rota no puede dejar tapada la tienda
    } else {
      cerrarConMinimo();
    }

    // Tope duro: pase lo que pase con las imágenes, a los 2,5 s se muestra la tienda.
    setTimeout(cerrar, 2500);
  })();
</script>

<style is:global>
  .carga {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--cream);
    display: flex;
    align-items: center;
    justify-content: center;
    /* Red de seguridad en CSS puro: si el script que la cierra fallara, la animación la
       retira igual a los 3,5 s. No depende de JavaScript. */
    animation: carga-salir 0.6s ease 3.5s forwards;
  }
  .carga[hidden] {
    display: none;
  }
  .carga.is-lista {
    animation: carga-salir 0.6s ease forwards;
  }
  .carga-logo {
    width: 190px;
    height: auto;
    /* Dos animaciones encadenadas: primero el logo APARECE con un fundido —antes surgía
       de golpe, que era lo brusco—, y recién después empieza un latido lento que dice
       "sigue trabajando" sin llamar la atención. El `both` hace que se quede en el
       estado final en vez de volver a saltar a opacidad 0. */
    animation:
      carga-logo-entra 0.7s ease-out both,
      carga-latir 2.4s ease-in-out 0.7s infinite;
  }
  @keyframes carga-salir {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
  @keyframes carga-logo-entra {
    from { opacity: 0; transform: scale(0.94); }
    to   { opacity: 1; transform: scale(1); }
  }
  @keyframes carga-latir {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.62; }
  }
  /* Bloquea el scroll mientras tapa, para que nadie se pierda desplazándose a ciegas. */
  html.esta-cargando,
  html.esta-cargando body {
    overflow: hidden;
  }

  @media (max-width: 520px) {
    .carga-logo { width: 150px; }
  }
  /* Quien pidió menos movimiento en su sistema no debería recibir un logo latiendo ni
     escalando: se muestra quieto y la pantalla se retira sin animación. */
  @media (prefers-reduced-motion: reduce) {
    .carga-logo { animation: none; opacity: 1; transform: none; }
    .carga, .carga.is-lista { animation-duration: 0.01s; }
  }
</style>
