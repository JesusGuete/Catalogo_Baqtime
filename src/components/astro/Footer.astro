---
// El footer de una línea (© Baqtime + link de WhatsApp) se amplió a la versión
// completa: barra de beneficios, columnas de marca/categorías/contacto y redes.
// Las categorías van a mano (no via loadCatalog) porque Footer se renderiza en 7
// páginas — incluido 404 y las de /pedido — y no todas cargan el catálogo de
// Supabase; son las mismas 6 líneas de producto de CATEGORY_LABELS en
// mock-catalog.js, que no cambian con la frecuencia de un producto puntual.
import { WHATSAPP_NUMBER } from "../../lib/whatsapp.js";

const whatsappHref = `https://wa.me/${WHATSAPP_NUMBER}`;

const CATEGORIAS_FOOTER = [
  { key: "tote", label: "Tote Personalizado" },
  { key: "tote-luxury", label: "Tote Bag Luxury" },
  { key: "lumiere", label: "Bag Lumiere" },
  { key: "neceser", label: "Neceser" },
  { key: "cosmetiquera", label: "Cosmetiquera" },
  { key: "makeup-bag", label: "Makeup Bag" },
];
---
<footer class="site-footer">
  <div class="footer-badges">
    <div class="footer-badge">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M4 20l4.2-1.2L19 8a2 2 0 0 0-3-3L5.2 15.8 4 20z" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M14 6.5l3.5 3.5" stroke-linecap="round"/>
      </svg>
      <span>Personalizado con tus iniciales</span>
    </div>
    <div class="footer-badge">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M3 11l9-7 9 7" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M5 10v10h14V10" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>Fabricado en Barranquilla</span>
    </div>
    <div class="footer-badge">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M20.5 3.5a16 16 0 0 0-17 17l3-1 1.3 4L4 25" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M7 8.5c1 3 3.5 5.5 6.5 6.5l1.5-2c1.5.5 3 .8 4.5.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>Pedidos por WhatsApp</span>
    </div>
    <div class="footer-badge">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <rect x="1" y="7" width="14" height="10" rx="1"/>
        <path d="M15 10h4l3 3v4h-7z"/>
        <circle cx="6" cy="19" r="1.5"/>
        <circle cx="18" cy="19" r="1.5"/>
      </svg>
      <span>Envíos a toda Colombia</span>
    </div>
  </div>

  <div class="footer-main">
    <div class="footer-brand">
      <p class="footer-logo">Baqtime</p>
      <p>Bolsos y accesorios personalizados<br />con tus iniciales.</p>
      <div class="footer-socials">
        <a class="footer-social" href="https://www.instagram.com/baqtime/" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
            <defs>
              <radialGradient id="igGradient" cx="30%" cy="107%" r="150%">
                <stop offset="0%" stop-color="#FFDD55"/>
                <stop offset="20%" stop-color="#FFDD55"/>
                <stop offset="40%" stop-color="#FF543E"/>
                <stop offset="70%" stop-color="#C837AB"/>
                <stop offset="100%" stop-color="#5851DB"/>
              </radialGradient>
            </defs>
            <rect x="2.75" y="2.75" width="18.5" height="18.5" rx="5.25" fill="url(#igGradient)"/>
            <circle cx="12" cy="12" r="4.25" fill="none" stroke="#fff" stroke-width="1.8"/>
            <circle cx="17.4" cy="6.6" r="1.25" fill="#fff"/>
          </svg>
          <span class="footer-social-name">Instagram</span>
        </a>
        <a class="footer-social" href="https://www.tiktok.com/@baqtime" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#25F4EE" d="M16.85 2.35h-3.2v14.15a3.15 3.15 0 1 1-2.15-2.98v-3.28a6.35 6.35 0 1 0 5.35 6.26V9.6a8.1 8.1 0 0 0 4.6 1.43V7.75a4.9 4.9 0 0 1-4.6-5.4z" transform="translate(-.35 -.35)"/>
            <path fill="#FE2C55" d="M16.85 2.35h-3.2v14.15a3.15 3.15 0 1 1-2.15-2.98v-3.28a6.35 6.35 0 1 0 5.35 6.26V9.6a8.1 8.1 0 0 0 4.6 1.43V7.75a4.9 4.9 0 0 1-4.6-5.4z" transform="translate(.35 .35)"/>
            <path fill="currentColor" d="M16.85 2.35h-3.2v14.15a3.15 3.15 0 1 1-2.15-2.98v-3.28a6.35 6.35 0 1 0 5.35 6.26V9.6a8.1 8.1 0 0 0 4.6 1.43V7.75a4.9 4.9 0 0 1-4.6-5.4z"/>
          </svg>
          <span class="footer-social-name">TikTok</span>
        </a>
      </div>
    </div>

    <div class="footer-col">
      <h4>Categorías</h4>
      {CATEGORIAS_FOOTER.map((c) => (
        <a href={`/catalogo?categoria=${c.key}`}>{c.label}</a>
      ))}
    </div>

    <div class="footer-col">
      <h4>Ayuda y contacto</h4>
      <a href="/catalogo">Ver catálogo</a>
      <a href={whatsappHref} target="_blank" rel="noopener">Escríbenos por WhatsApp</a>
      <p class="footer-fine">
        Horario de atención: lunes a domingo
        <br />
        10:00 a.m. a 10:00 p.m.
      </p>
    </div>
  </div>

  <div class="footer-bottom">
    © Baqtime — Catálogo digital · Pedidos por
    {" "}
    <a href={whatsappHref} target="_blank" rel="noopener">WhatsApp +57 313 4954478</a>
  </div>
</footer>
