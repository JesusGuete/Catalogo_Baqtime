---
// El número de pedido en grande, con el botón COPIAR.
//
// Es lo que el cliente necesita recordar: con él consulta el estado desde /pedido. Por eso va
// con el tamaño y el acento de la marca, y no como un dato más. Lo usan la página de gracias y
// la de resultado del pago.
interface Props {
  numero: string;
}

const { numero } = Astro.props;
---

<div class="np-caja" data-numero-pedido>
  <span class="np-label mono">TU NÚMERO DE PEDIDO</span>
  <strong class="np-numero mono" data-numero>{numero}</strong>
  <button class="np-btn mono" type="button" data-copiar>COPIAR</button>
</div>

<script>
  // Con respaldo: clipboard.writeText no existe fuera de HTTPS ni en navegadores viejos, y
  // quedarse sin forma de copiar el número sería justamente el problema que esto resuelve. Sin
  // API de portapapeles, se selecciona el número para copiarlo con el gesto de siempre.
  document.querySelectorAll<HTMLElement>("[data-numero-pedido]").forEach((caja) => {
    const numero = caja.querySelector<HTMLElement>("[data-numero]");
    const boton = caja.querySelector<HTMLButtonElement>("[data-copiar]");
    if (!numero || !boton) return;
    boton.addEventListener("click", () => {
      const listo = () => {
        boton.textContent = "COPIADO ✓";
        setTimeout(() => (boton.textContent = "COPIAR"), 2000);
      };
      const texto = (numero.textContent ?? "").trim();
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(texto).then(listo);
      } else {
        const rango = document.createRange();
        rango.selectNodeContents(numero);
        const seleccion = window.getSelection();
        seleccion?.removeAllRanges();
        seleccion?.addRange(rango);
        listo();
      }
    });
  });
</script>

<style>
  .np-caja {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    padding: 18px 20px;
    margin-bottom: 16px;
    background: var(--draft-bg);
    border: 1px solid var(--draft-border);
    border-radius: var(--radius);
  }
  .np-label {
    flex: 1 0 100%;
    font-size: 9px;
    letter-spacing: 0.1em;
    color: var(--draft-text);
  }
  .np-numero {
    font-size: 30px;
    letter-spacing: 0.06em;
    color: var(--ink);
    font-weight: 400;
  }
  .np-btn {
    margin-left: auto;
    padding: 8px 14px;
    font-size: 11px;
    letter-spacing: 0.08em;
    background: var(--white-card);
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    color: var(--ink);
    cursor: pointer;
  }
</style>
