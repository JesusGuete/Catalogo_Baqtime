---
// Portado tal cual desde .portada-carousel en index.html + collections-carousel.js.
// El scroll (arrastre táctil/mouse) sigue siendo 100% nativo vía CSS scroll-snap —
// el script de abajo solo mueve el scroll cuando se hace clic en las flechas,
// igual que hacía collections-carousel.js. Por eso esto NO es una isla React
// (ver tabla "Qué es isla React y qué no" en docs/plan-mejoramiento.md).
//
// LAS TARJETAS SALEN DE LA BASE, NO DEL CÓDIGO (016_categoria_portada.sql).
//
// Antes eran seis objetos escritos a mano acá: título, descripción y ruta de la foto.
// Crear una categoría desde el panel NO la hacía aparecer en la portada —había que
// editar este archivo y volver a desplegar—, y borrarla dejaba su tarjeta apuntando a
// un catálogo vacío. Las seis eran exactamente las seis categorías, así que ahora se
// leen de `categories` y se editan desde la pantalla Categorías del panel.
//
// SOLO SALEN LAS QUE TIENEN FOTO. Una categoría sin portada no se dibuja: una tarjeta
// con un hueco donde va la imagen se ve rota, y es peor que no estar. Así el dueño
// controla qué aparece sin necesidad de un interruptor aparte — sube la foto y aparece.
import type { Category } from "../../types/database";

interface Props {
  categorias: Category[];
}
const { categorias } = Astro.props;

const collections = categorias.filter((c) => c.portada_img);
---
<h2 class="portada-heading">Nuestras colecciones</h2>
<div class="portada-carousel">
  <button type="button" class="portada-arrow portada-arrow-left" id="portadaPrevBtn" aria-label="Ver colecciones anteriores">‹</button>
  <div class="portada-viewport">
    <div class="portada" id="portadaTrack">
      {collections.map((c) => (
        // Toda la tarjeta es UN SOLO enlace, no un div con un botón adentro. En
        // celular el botón "Ver colección" se oculta (site.css, regla de
        // .portada-body .btn) para que la tarjeta se vea como en la referencia de
        // Louis Vuitton: solo foto y nombre. Si el enlace viviera únicamente en ese
        // botón, ocultarlo dejaría la tarjeta sin ninguna forma de tocarla — que es
        // exactamente el bug que esto corrige. Con la tarjeta entera como <a>, el
        // botón visible en escritorio es decorativo: un atajo visual sobre un
        // enlace que ya cubre toda el área.
        <a href={`/catalogo?categoria=${c.key}`} class="portada-card">
          {/* Sin width/height: la foto la sube el dueño y sus medidas cambian con cada
              una. El contenedor .portada-img ya fija la proporción en CSS, asi que no
              hay salto de maquetación al cargar. */}
          <div class="portada-img"><img src={c.portada_img} alt={c.label} loading="lazy" /></div>
          <div class="portada-body">
            {/* La flecha solo se ve en celular (site.css la oculta en escritorio, donde
                ya está el botón "Ver colección"). Sin ella, foto + nombre no dan ninguna
                pista de que la tarjeta lleva a algo — un cliente nuevo tendría que
                adivinarlo o tocar por curiosidad. Es el mismo símbolo que usa iOS para
                "toca para entrar", así que no hace falta explicarlo.
                aria-hidden porque es decorativa: el <a> ya anuncia "enlace" solo. */}
            <h3>{c.label} <span class="portada-chevron" aria-hidden="true">›</span></h3>
            {c.portada_desc && <p>{c.portada_desc}</p>}
            <span class="btn btn-ghost" aria-hidden="true">Ver colección</span>
          </div>
        </a>
      ))}
    </div>
  </div>
  <button type="button" class="portada-arrow portada-arrow-right" id="portadaNextBtn" aria-label="Ver más colecciones">›</button>
</div>

<script>
  // Flechas: scroll nativo, un "paso" = el ancho de una tarjeta + separación.
  // Portado tal cual desde collections-carousel.js.
  const viewport = document.querySelector<HTMLElement>(".portada-viewport")!;
  const track = document.getElementById("portadaTrack")!;
  const prevBtn = document.getElementById("portadaPrevBtn") as HTMLButtonElement;
  const nextBtn = document.getElementById("portadaNextBtn") as HTMLButtonElement;
  const cards = Array.from(track.children) as HTMLElement[];

  function cardStep() {
    const cardWidth = cards[0].getBoundingClientRect().width;
    const gap = parseFloat(getComputedStyle(track).gap) || 0;
    return cardWidth + gap;
  }

  function updateArrows() {
    const maxScroll = track.scrollWidth - viewport.clientWidth;
    prevBtn.disabled = viewport.scrollLeft <= 1;
    nextBtn.disabled = viewport.scrollLeft >= maxScroll - 1;
  }

  prevBtn.addEventListener("click", () => {
    viewport.scrollBy({ left: -cardStep(), behavior: "smooth" });
  });
  nextBtn.addEventListener("click", () => {
    viewport.scrollBy({ left: cardStep(), behavior: "smooth" });
  });
  viewport.addEventListener("scroll", updateArrows);
  window.addEventListener("resize", updateArrows);
  updateArrows();
</script>
