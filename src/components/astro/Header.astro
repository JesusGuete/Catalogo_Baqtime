---
// Portado desde <header> en index.html.
// El botón del carrito es una isla React mínima (CartBadge) porque necesita
// mostrar el contador en vivo; el resto del encabezado sigue siendo HTML estático.
import CartBadge from "../react/CartBadge.jsx";
import SearchBadge from "../react/SearchBadge.jsx";
---
<header>
  <!-- width/height son las dimensiones reales del archivo (998x297). No fijan el
       tamaño en pantalla — de eso se encarga `.brand-logo` con height:38px y el
       `img{height:auto}` global. Sirven para que el navegador reserve el espacio
       antes de que la imagen cargue y el encabezado no salte. -->
  <!-- El logo vuelve al inicio, igual que en el panel. Es lo que todo el mundo intenta
       tocar para volver, y hasta ahora no hacía nada. -->
  <a href="/" class="brand-link" aria-label="Ir al inicio">
    <img
      src="/assets/img/logo.png"
      alt="Baqtime"
      class="brand-logo"
      width="998"
      height="297"
    />
  </a>
  <div class="cart-note">Barranquilla y Cartagena, Colombia</div>
  <!-- "Mi pedido" y el carrito van juntos: son las dos acciones del encabezado, y
       agruparlas evita que el `justify-content: space-between` del <header> las separe a
       los extremos con la nota de ciudades en el medio. -->
  <div class="header-acciones">
    <a class="header-pedido mono" href="/pedido">MI PEDIDO</a>
    <SearchBadge client:load />
    <CartBadge client:load />
  </div>
</header>
