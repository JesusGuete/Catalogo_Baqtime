---
// PRUEBA — rama prueba/catalogo-y-menu. No está en main.
//
// La barra superior en tres zonas, con el logo centrado: acciones a los lados, marca en
// el medio. A la izquierda el lado de "ir a" (menú y buscador), a la derecha el de "lo
// mío" (mi pedido, mi carrito).
//
// TRES ZONAS Y NO `space-between`. Con el espacio repartido, el logo se "centra" respecto
// al hueco que le dejan sus vecinos: basta con que algo crezca un píxel para que la marca
// se corra. La rejilla `1fr auto 1fr` de site.css le da al centro su propia columna.
//
// El menú, el buscador y el carrito son islas React porque necesitan estado en vivo (el
// panel desplegado, el contador); el resto del encabezado es HTML estático.
import CartBadge from "../react/CartBadge.jsx";
import MenuBadge from "../react/MenuBadge.jsx";
import SearchBadge from "../react/SearchBadge.jsx";

interface Props {
  /** Categorías para el panel del menú. Las páginas sin catálogo no las pasan. */
  categorias?: { key: string | null; label: string }[];
  /** Productos para el panel del buscador: se muestran antes de escribir nada. */
  destacados?: { id: string; name: string; price: number; img: string }[];
}
const { categorias = [], destacados = [] } = Astro.props as Props;
---
<header>
  <div class="header-zona header-zona--izq">
    <MenuBadge client:load categorias={categorias} />
    <SearchBadge client:load destacados={destacados} />
  </div>

  <!-- width/height son las dimensiones reales del archivo (998x297). No fijan el tamaño
       en pantalla —de eso se encarga `.brand-logo`—: reservan el espacio antes de que la
       imagen cargue, para que el encabezado no salte.

       El logo vuelve al inicio, igual que en el panel. Es lo que todo el mundo intenta
       tocar para volver. -->
  <a href="/" class="brand-link" aria-label="Ir al inicio">
    <img
      src="/assets/img/logo.png"
      alt="Baqtime"
      class="brand-logo"
      width="998"
      height="297"
    />
  </a>

  <div class="header-zona header-zona--der">
    <a class="header-pedido mono" href="/pedido">MI PEDIDO</a>
    <CartBadge client:load />
  </div>
</header>
