---
// Catálogo público.
//
// Se renderiza por petición, no en el build: publicar desde el panel se ve en la
// tienda sin reconstruir nada.
import PantallaCarga from "../components/astro/PantallaCarga.astro";
import Header from "../components/astro/Header.astro";
import Hero from "../components/astro/Hero.astro";
import CollectionsCarousel from "../components/astro/CollectionsCarousel.astro";
import Footer from "../components/astro/Footer.astro";
import WhatsappWidget from "../components/react/WhatsappWidget.jsx";
import SiteHead from "../components/astro/SiteHead.astro";
import ShopApp from "../components/react/ShopApp.jsx";
import { loadCatalog } from "../lib/catalog";
import "../styles/site.css";

// Cloudflare guarda el HTML ya renderizado en el edge, así que la mayoría de las
// visitas no llegan a Supabase. `s-maxage=60` acota cuánto puede tardar en verse un
// precio nuevo; `stale-while-revalidate` hace que nadie espere por una caché fría —
// se sirve la copia anterior y se refresca detrás. Bajar el 60 acerca el "tiempo
// real" a costa de más consultas.
Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=60, stale-while-revalidate=300"
);

const catalog = await loadCatalog();

const url = new URL("/", Astro.site).href;
const titulo = "Baqtime — Bolsos y Accesorios Personalizados";
const descripcion =
  "Bolsos y accesorios personalizados: tote bags bordados con tus iniciales, neceseres y bags Lumiere. Hechos en Barranquilla y Cartagena, pedidos por WhatsApp.";

// El logo suelto medía 998x297: por debajo del mínimo de LinkedIn, que descartaba la
// imagen y compartía la tienda sin nada. og-image.png es ese mismo logo sobre el crema
// de la marca, en el 1200x630 que esperan todas las plataformas.
const imagen = new URL("/assets/img/og-image.png", Astro.site).href;

// Organization + WebSite. Le dice a Google que baqtime.store y "Baqtime" son la misma
// entidad; sin esto el nombre de la marca en los resultados es lo que el buscador
// adivine del título. El @id enlaza los dos nodos en vez de repetir los datos.
const datosEstructurados = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${url}#organizacion`,
      name: "Baqtime",
      url,
      logo: new URL("/assets/img/logo.png", Astro.site).href,
      image: imagen,
      description: descripcion,
      areaServed: [
        { "@type": "City", name: "Barranquilla" },
        { "@type": "City", name: "Cartagena" },
      ],
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "sales",
        telephone: "+573505675343",
        availableLanguage: "es",
      },
    },
    {
      "@type": "WebSite",
      "@id": `${url}#sitio`,
      url,
      name: "Baqtime",
      inLanguage: "es-CO",
      publisher: { "@id": `${url}#organizacion` },
    },
  ],
};
---

<html lang="es-CO">
<head>
  <SiteHead
    title={titulo}
    description={descripcion}
    url={url}
    image={imagen}
    imageAlt="Logo de Baqtime sobre fondo crema"
    imageSize={{ width: 1200, height: 630 }}
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(datosEstructurados)}
  />
</head>
<body>
  <!-- Primero de todo: su script tiene que correr antes de que el navegador empiece a
       pintar el contenido, o se vería un destello de la tienda antes de taparla. -->
  <PantallaCarga />
  <Header />
  <Hero />
  <CollectionsCarousel />
  <ShopApp client:load catalog={catalog} />
  <Footer />
    <WhatsappWidget client:load />
</body>
</html>
