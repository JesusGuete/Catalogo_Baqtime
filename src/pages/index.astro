---
// Catálogo público.
//
// Se renderiza por petición, no en el build: publicar desde el panel se ve en la
// tienda sin reconstruir nada.
//
// Falta todavía la página de producto con URL propia — hoy el producto se abre en un
// modal y la URL no cambia, así que no hay nada que un buscador pueda indexar por
// producto.
import Header from "../components/astro/Header.astro";
import Hero from "../components/astro/Hero.astro";
import CollectionsCarousel from "../components/astro/CollectionsCarousel.astro";
import Footer from "../components/astro/Footer.astro";
import ShopApp from "../components/react/ShopApp.jsx";
import { loadCatalog } from "../lib/catalog";
import "../styles/site.css";

// Cloudflare guarda el HTML ya renderizado en el edge, así que la mayoría de las
// visitas no llegan a Supabase. `s-maxage=60` acota cuánto puede tardar en verse un
// precio nuevo; `stale-while-revalidate` hace que nadie espere por una caché fría —
// se sirve la copia anterior y se refresca detrás. Bajar el 60 acerca el "tiempo
// real" a costa de más consultas.
Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=60, stale-while-revalidate=300"
);

const catalog = await loadCatalog();
---

<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Baqtime — Bolsos y Accesorios Personalizados</title>
  <meta name="description" content="Bolsos y accesorios personalizados: tote bags bordados con tus iniciales, neceseres y bags Lumiere. Hechos en Barranquilla y Cartagena, pedidos por WhatsApp." />
  <link rel="canonical" href="https://baqtime.store/" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Baqtime" />
  <meta property="og:title" content="Baqtime — Bolsos y Accesorios Personalizados" />
  <meta property="og:description" content="Bolsos y accesorios personalizados: tote bags bordados con tus iniciales, neceseres y bags Lumiere. Hechos en Barranquilla y Cartagena, pedidos por WhatsApp." />
  <meta property="og:url" content="https://baqtime.store/" />
  <meta property="og:image" content="https://baqtime.store/assets/img/logo.png" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Unna:ital,wght@0,400;0,700;1,400&family=Work+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <Header />
  <Hero />
  <CollectionsCarousel />
  <ShopApp client:load catalog={catalog} />
  <Footer />
</body>
</html>
