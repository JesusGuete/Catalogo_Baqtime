---
// Confirmación inmediata, justo después de guardar el pedido.
//
// Existe por una razón concreta: el enlace de seguimiento también viaja dentro del mensaje
// de WhatsApp, pero el mensaje lo tiene que ENVIAR el cliente. Si cierra WhatsApp sin
// mandarlo, o lo edita, se queda sin enlace y el pedido —que ya está guardado— queda
// huérfano de su dueño. Mostrarlo también acá, en pantalla y copiable, es la red de
// seguridad.
import PedidoHead from "../../components/astro/PedidoHead.astro";
import Header from "../../components/astro/Header.astro";
import Footer from "../../components/astro/Footer.astro";
import { obtenerPedido, cabecerasPrivadas } from "../../lib/pedido";
import { buildOrderMessage, whatsappUrl } from "../../lib/whatsapp.js";
import { fmt } from "../../lib/pricing.js";
import "../../styles/site.css";

export const prerender = false;

cabecerasPrivadas(Astro.response.headers);

const token = Astro.url.searchParams.get("p") ?? "";
const resultado = await obtenerPedido(token);

// Acá un fallo de la base es especialmente feo: el pedido ACABA de guardarse, así que
// existe seguro. Mandarlo al enlace de seguimiento es mejor que un 404 que lo asuste
// después de haber comprado.
if (resultado.estado === "error") {
  return Astro.redirect(`/pedido/${encodeURIComponent(token)}`, 302);
}
if (resultado.estado === "no-existe") {
  return new Response(null, { status: 404, statusText: "Pedido no encontrado" });
}
const pedido = resultado.pedido;

const urlSeguimiento = new URL(`/pedido/${token}`, Astro.url.origin).href;
const mensaje = buildOrderMessage(pedido, urlSeguimiento);
const enlaceWhatsapp = whatsappUrl(mensaje);
---

<html lang="es-CO">
  <head>
    <PedidoHead title={`Pedido ${pedido.order_number} — Baqtime`} />
  </head>
  <body>
    <Header />

    <main class="ped-wrap">
      <section class="ped-card">
        <p class="ped-eyebrow mono">PEDIDO REGISTRADO</p>
        <h1 class="ped-titulo">¡Gracias, {pedido.customer_name.split(" ")[0]}!</h1>
        <p class="ped-bajada">
          Tu pedido quedó guardado. El siguiente paso es coordinar el pago por WhatsApp.
        </p>

        <div class="ped-resumen">
          <div class="ped-dato">
            <span class="ped-dato-label mono">NÚMERO DE PEDIDO</span>
            <span class="ped-dato-valor mono">{pedido.order_number}</span>
          </div>
          <div class="ped-dato">
            <span class="ped-dato-label mono">TOTAL A PAGAR</span>
            <span class="ped-dato-valor">{fmt(pedido.total)}</span>
          </div>
        </div>

        <a class="ped-btn-wa" href={enlaceWhatsapp}>Confirmar pago por WhatsApp</a>

        <div class="ped-enlace">
          <p class="ped-enlace-titulo">Guardá este enlace para seguir tu pedido</p>
          <div class="ped-enlace-caja">
            <input
              id="enlace"
              class="ped-enlace-input mono"
              type="text"
              readonly
              value={urlSeguimiento}
              aria-label="Enlace de seguimiento de tu pedido"
            />
            <button id="copiar" class="ped-enlace-btn mono" type="button">COPIAR</button>
          </div>
          <p class="ped-nota">
            Es tu enlace personal: solo quien lo tenga puede ver este pedido. También te
            queda dentro del mensaje de WhatsApp.
          </p>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline>
      // Sin dependencias y con respaldo: clipboard.writeText no existe fuera de HTTPS ni
      // en navegadores viejos, y quedarse sin forma de copiar el enlace sería justamente
      // el problema que esta página vino a resolver.
      document.getElementById("copiar")?.addEventListener("click", function () {
        var input = document.getElementById("enlace");
        var boton = this;
        function ok() {
          boton.textContent = "COPIADO ✓";
          setTimeout(function () {
            boton.textContent = "COPIAR";
          }, 2000);
        }
        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(input.value).then(ok);
        } else {
          input.select();
          document.execCommand("copy");
          ok();
        }
      });
    </script>

    <style>
      .ped-wrap {
        max-width: 640px;
        margin: 0 auto;
        padding: 48px 20px 72px;
      }
      .ped-card {
        background: var(--white-card);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 32px 28px;
      }
      .ped-eyebrow {
        font-size: 10px;
        letter-spacing: 0.12em;
        color: var(--mocha);
        margin: 0 0 10px;
      }
      .ped-titulo {
        font-family: "Unna", serif;
        font-size: 30px;
        line-height: 1.15;
        margin: 0 0 8px;
        color: var(--ink);
      }
      .ped-bajada {
        font-size: 14px;
        line-height: 1.6;
        color: var(--ink-soft);
        margin: 0 0 24px;
      }
      .ped-resumen {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 24px;
      }
      .ped-dato {
        flex: 1 1 180px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 14px 16px;
        background: var(--cream);
        border: 1px solid var(--line);
        border-radius: var(--radius);
      }
      .ped-dato-label {
        font-size: 9px;
        letter-spacing: 0.1em;
        color: var(--ink-soft);
      }
      .ped-dato-valor {
        font-size: 20px;
        color: var(--ink);
      }
      .ped-btn-wa {
        display: block;
        width: 100%;
        padding: 15px;
        text-align: center;
        text-decoration: none;
        background: var(--ink);
        color: var(--cream);
        border-radius: var(--radius);
        font-size: 14px;
        letter-spacing: 0.04em;
      }
      .ped-btn-wa:hover {
        background: var(--mocha);
      }
      .ped-enlace {
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid var(--line);
      }
      .ped-enlace-titulo {
        font-size: 13px;
        color: var(--ink);
        margin: 0 0 10px;
      }
      .ped-enlace-caja {
        display: flex;
        gap: 8px;
      }
      .ped-enlace-input {
        flex: 1;
        min-width: 0;
        /* 16px real: por debajo de eso Safari en iPhone hace zoom al enfocar el campo. */
        font-size: 16px;
        padding: 10px 12px;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--cream);
        color: var(--ink-soft);
      }
      .ped-enlace-btn {
        flex-shrink: 0;
        padding: 0 16px;
        font-size: 11px;
        letter-spacing: 0.08em;
        background: var(--white-card);
        border: 1px solid var(--ink);
        border-radius: var(--radius);
        color: var(--ink);
        cursor: pointer;
      }
      .ped-nota {
        font-size: 12px;
        line-height: 1.55;
        color: var(--ink-soft);
        margin: 10px 0 0;
      }
      @media (max-width: 520px) {
        .ped-wrap {
          padding: 28px 16px 56px;
        }
        .ped-card {
          padding: 24px 18px;
        }
        .ped-titulo {
          font-size: 25px;
        }
      }
    </style>
  </body>
</html>
