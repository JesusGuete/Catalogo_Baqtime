---
// Confirmación inmediata, justo después de guardar el pedido.
//
// Lo que el cliente tiene que llevarse de acá es SU NÚMERO DE PEDIDO: con eso y su
// teléfono consulta el estado cuando quiera desde /pedido. Por eso el número es lo más
// grande de la pantalla y no un dato más del resumen.
//
// El enlace directo sigue existiendo como botón —ahorra escribir dos datos a quien está
// acá y ahora— pero ya no se muestra la URL en crudo: es larga, y el cliente no la
// necesita si tiene su número.
//
// EL PAGO: con los pagos en línea encendidos (PAGOS_EN_LINEA, src/lib/pagos.ts), el botón
// principal es "Pagar ahora" y lleva a /pedido/pagar/<token>, con los medios de pago de Wompi en
// la misma tienda. WhatsApp queda como opción secundaria, para quien prefiere transferir. Con el
// interruptor apagado, la página es la de siempre: el pago se coordina por WhatsApp.
import PedidoHead from "../../components/astro/PedidoHead.astro";
import Header from "../../components/astro/Header.astro";
import Footer from "../../components/astro/Footer.astro";
import WhatsappWidget from "../../components/react/WhatsappWidget.jsx";
import BotonPagar from "../../components/astro/BotonPagar.astro";
import NumeroPedido from "../../components/astro/NumeroPedido.astro";
import ResumenPedido from "../../components/astro/ResumenPedido.astro";
import { obtenerPedido, cabecerasPrivadas } from "../../lib/pedido";
import { pagosEnLineaActivos } from "../../lib/pagos";
import { buildOrderMessage, whatsappUrl } from "../../lib/whatsapp.js";
import "../../styles/site.css";

export const prerender = false;

cabecerasPrivadas(Astro.response.headers);

const token = Astro.url.searchParams.get("p") ?? "";
const resultado = await obtenerPedido(token);

// Acá un fallo de la base es especialmente feo: el pedido ACABA de guardarse, así que
// existe seguro. Mandarlo al enlace de seguimiento es mejor que un 404 que lo asuste
// después de haber comprado.
if (resultado.estado === "error") {
  return Astro.redirect(`/pedido/${encodeURIComponent(token)}`, 302);
}
if (resultado.estado === "no-existe") {
  return new Response(null, { status: 404, statusText: "Pedido no encontrado" });
}
const pedido = resultado.pedido;

const enlaceWhatsapp = whatsappUrl(buildOrderMessage(pedido));

// `pago` llega desde 027_pagos_en_linea.sql. Sin él (la migración no se ha corrido), no se
// ofrece pagar en línea aunque el interruptor esté encendido.
const pagado = pedido.pago === "pagado";
const pagarEnLinea =
  pagosEnLineaActivos(Astro.url.hostname) &&
  pedido.status === "pendiente_pago" &&
  (pedido.pago === "pendiente" || pedido.pago === "en_proceso");
---

<html lang="es-CO">
  <head>
    <PedidoHead title={`Pedido ${pedido.order_number} — Baqtime`} />
  </head>
  <body>
    <Header />

    <main class="ped-wrap">
      <section class="ped-card">
        <p class="ped-eyebrow mono">PEDIDO REGISTRADO</p>
        <h1 class="ped-titulo">¡Gracias, {pedido.customer_name.split(" ")[0]}!</h1>
        <p class="ped-bajada">
          {
            pagado
              ? "Tu pedido quedó guardado y ya recibimos el pago."
              : pagarEnLinea
                ? "Tu pedido quedó guardado. El siguiente paso es pagarlo."
                : "Tu pedido quedó guardado. El siguiente paso es coordinar el pago por WhatsApp."
          }
        </p>

        <NumeroPedido numero={pedido.order_number} />
        <ResumenPedido pedido={pedido} etiquetaTotal={pagado ? "Total pagado" : "Total a pagar"} />

        {
          pagarEnLinea ? (
            pedido.pago === "en_proceso" ? (
              <p class="ped-proceso">
                Tu pago se está procesando. Te avisaremos por correo apenas se confirme; no hace
                falta que vuelvas a pagar.
              </p>
            ) : (
              <>
                <BotonPagar token={token} />
                <a class="ped-alterno" href={enlaceWhatsapp}>
                  Prefiero pagar por transferencia (WhatsApp)
                </a>
              </>
            )
          ) : (
            !pagado && (
              <a class="ped-btn-wa" href={enlaceWhatsapp}>
                Confirmar pago por WhatsApp
              </a>
            )
          )
        }

        {/* Sin mostrar la dirección: esta página no la conoce (pedido_publico no devuelve
            el correo, a propósito). Lo de Spam va porque los primeros correos de un
            dominio nuevo son los que más caen ahí. */}
        <p class="ped-correo">
          Te enviamos el resumen a tu correo. Si no lo ves en unos minutos, revisa la carpeta
          de Spam o Promociones.
        </p>

        <p class="ped-nota">
          Guarda tu número: con él puedes consultar el estado cuando quieras desde
          <strong>Mi pedido</strong>, arriba en esta misma página.
        </p>
      </section>
    </main>

    <Footer />
    <WhatsappWidget client:load />


    <style>
      .ped-wrap {
        max-width: 640px;
        margin: 0 auto;
        padding: 48px 20px 72px;
      }
      .ped-card {
        background: var(--white-card);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 32px 28px;
      }
      .ped-eyebrow {
        font-size: 10px;
        letter-spacing: 0.12em;
        color: var(--mocha);
        margin: 0 0 10px;
      }
      .ped-titulo {
        font-family: "Unna", serif;
        font-size: 30px;
        line-height: 1.15;
        margin: 0 0 8px;
        color: var(--ink);
      }
      .ped-bajada {
        font-size: 14px;
        line-height: 1.6;
        color: var(--ink-soft);
        margin: 0 0 24px;
      }
      .ped-btn-wa {
        display: block;
        width: 100%;
        padding: 15px;
        text-align: center;
        text-decoration: none;
        background: var(--ink);
        color: var(--cream);
        border-radius: var(--radius);
        font-size: 14px;
        letter-spacing: 0.04em;
      }
      .ped-btn-wa:hover {
        background: var(--mocha);
      }
      .ped-alterno {
        display: block;
        margin-top: 14px;
        font-size: 13px;
        color: var(--ink-soft);
        text-align: center;
      }
      .ped-proceso {
        margin: 0;
        padding: 14px 16px;
        font-size: 14px;
        line-height: 1.55;
        color: var(--ink);
        background: var(--live-bg);
        border: 1px solid var(--live-border);
        border-radius: var(--radius);
      }
      .ped-correo {
        margin: 12px 0 0;
        font-size: 12px;
        line-height: 1.55;
        color: var(--ink-soft);
        text-align: center;
      }
      .ped-nota {
        margin-top: 22px;
        padding-top: 18px;
        border-top: 1px solid var(--line);
        font-size: 12px;
        line-height: 1.55;
        color: var(--ink-soft);
        margin: 10px 0 0;
      }
      @media (max-width: 520px) {
        .ped-wrap {
          padding: 28px 16px 56px;
        }
        .ped-card {
          padding: 24px 18px;
        }
        .ped-titulo {
          font-size: 25px;
        }
      }
    </style>
  </body>
</html>
