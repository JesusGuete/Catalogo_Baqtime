# Plantilla de variables de entorno — Migración Astro + React + Supabase
# Copiar como .env (NO subir .env al repo — ya está en .gitignore).
# Los valores reales se completan en la Fase 1, cuando se reciba
# la configuración de Supabase (ver docs/plan-mejoramiento.md, punto 5).

# URL del proyecto Supabase (pública por diseño)
PUBLIC_SUPABASE_URL=

# anon key de Supabase (pública por diseño, va también en el cliente/panel)
PUBLIC_SUPABASE_ANON_KEY=

# Nombre del bucket de Supabase Storage donde viven las imágenes de producto
PUBLIC_SUPABASE_STORAGE_BUCKET=

# service_role key — saltea RLS por completo.
#
# La usa UN solo archivo: src/pages/api/pedidos.ts, que corre en el servidor y es
# el único que puede escribir en `orders` (esas tablas no tienen politica de
# INSERT para nadie). Sin esta variable el checkout devuelve 503 y no se puede
# hacer ningun pedido.
#
# NUNCA se usa en codigo de cliente, NUNCA se commitea, NUNCA se pega en el chat.
# Por eso tampoco esta declarada en src/env.d.ts: si no esta en el tipo,
# escribirla en un componente es un error de compilacion.
#
# En produccion no viene de este archivo: se carga como secreto del Worker en
# Cloudflare (Settings -> Variables and Secrets -> Add -> Secret).
SUPABASE_SERVICE_ROLE_KEY=

# --- Correo de confirmación del pedido (src/lib/correo.ts) -------------------------
#
# Clave de API de Resend (resend.com -> API Keys). Es un SECRETO, igual que la de
# arriba: en producción va como secreto del Worker, nunca en el repo ni en el chat.
# Sin ella los pedidos se guardan igual, pero no sale ningún correo y el panel lo
# marca como "no enviado" para reenviarlo después.
RESEND_API_KEY=

# Remitente. El dominio tiene que estar verificado en Resend (registros DNS en
# Cloudflare), o Resend rechaza el envío. Si se deja vacío se usa este mismo valor.
CORREO_REMITENTE=Baqtime <pedidos@baqtime.store>

# A dónde llegan las respuestas de los clientes (Reply-To). Opcional: si queda vacío,
# el correo no invita a responder, porque pedidos@ no es un buzón que alguien lea.
CORREO_RESPONDER_A=

# A dónde llega la copia de cada pedido nuevo para la tienda (nombre, teléfono, documento,
# dirección, productos). Opcional: si queda vacío se usa CORREO_RESPONDER_A, y si tampoco hay,
# no se manda copia. Es siempre configuración de la tienda, nunca una dirección que escriba un
# cliente. Al responder esa copia, la respuesta va al cliente que hizo el pedido.
CORREO_AVISO_PEDIDOS=

# --- Pagos en línea con Wompi (src/lib/pagos.ts) -------------------------------------
#
# Se sacan del panel web de Wompi (comercios.wompi.co), no de la app del celular. Hay un juego
# por ambiente: los de prueba (sandbox) empiezan por pub_test_ / prv_test_ / test_integrity_ /
# test_events_, y los de producción por pub_prod_ / prv_prod_ / prod_integrity_ / prod_events_.
# Las cuatro tienen que ser del MISMO ambiente; si se mezclan, los pagos en línea quedan
# apagados y el log del Worker dice por qué.
#
# NUNCA se pegan en el chat ni se suben al repo. En producción la privada y los dos secretos van
# como Secret del Worker (Settings -> Variables and Secrets -> Add -> Secret).

# Llave pública. Va al navegador dentro del checkout de Wompi: no es un secreto, pero se lee en
# el servidor (no es PUBLIC_) para poder cambiar de sandbox a producción sin reconstruir.
WOMPI_PUBLIC_KEY=

# Llave privada. SECRETO. Con ella el servidor le pregunta a Wompi el estado de un pago.
WOMPI_PRIVATE_KEY=

# Secreto de integridad. SECRETO. Firma el monto de cada cobro para que no se pueda cambiar.
WOMPI_INTEGRITY_SECRET=

# Secreto de eventos. SECRETO. Comprueba que un aviso (webhook) de verdad viene de Wompi.
WOMPI_EVENTS_SECRET=

# El interruptor. "1" muestra "Pagar ahora" en la tienda; vacío o cualquier otra cosa deja el
# pago por WhatsApp como siempre. Es una variable de texto: se cambia en Cloudflare sin deploy.
PAGOS_EN_LINEA=
