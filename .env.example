# Plantilla de variables de entorno — Migración Astro + React + Supabase
# Copiar como .env (NO subir .env al repo — ya está en .gitignore).
# Los valores reales se completan en la Fase 1, cuando se reciba
# la configuración de Supabase (ver docs/plan-mejoramiento.md, punto 5).

# URL del proyecto Supabase (pública por diseño)
PUBLIC_SUPABASE_URL=

# anon key de Supabase (pública por diseño, va también en el cliente/panel)
PUBLIC_SUPABASE_ANON_KEY=

# Nombre del bucket de Supabase Storage donde viven las imágenes de producto
PUBLIC_SUPABASE_STORAGE_BUCKET=

# service_role key — saltea RLS por completo.
#
# La usa UN solo archivo: src/pages/api/pedidos.ts, que corre en el servidor y es
# el único que puede escribir en `orders` (esas tablas no tienen politica de
# INSERT para nadie). Sin esta variable el checkout devuelve 503 y no se puede
# hacer ningun pedido.
#
# NUNCA se usa en codigo de cliente, NUNCA se commitea, NUNCA se pega en el chat.
# Por eso tampoco esta declarada en src/env.d.ts: si no esta en el tipo,
# escribirla en un componente es un error de compilacion.
#
# En produccion no viene de este archivo: se carga como secreto del Worker en
# Cloudflare (Settings -> Variables and Secrets -> Add -> Secret).
SUPABASE_SERVICE_ROLE_KEY=
